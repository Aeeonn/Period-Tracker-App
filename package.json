{
  "name": "flo-lite",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:e2e": "VITE_RELAY_URL=https://relay.test vite build --outDir dist-e2e",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "relay:dev": "wrangler dev --config relay/wrangler.toml",
    "relay:deploy": "wrangler deploy --config relay/wrangler.toml"
  },
  "dependencies": {
    "idb": "8.0.3",
    "preact": "11.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "eslint": "10.11.0",
    "fake-indexeddb": "6.2.7",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "7.3.6",
    "vitest": "4.1.12",
    "wrangler": "4.147.0"
  }
}
