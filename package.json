{
  "name": "private-cycle-tracker-toolchain",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check package.json package-lock.json tsconfig.json vite.config.ts vitest.config.ts playwright.config.ts eslint.config.js .prettierrc tools/allowed-licenses.json tools/*.ts tests/golden/README.md",
    "check:deps": "tsx tools/check-deps.ts",
    "check:secrets": "tsx tools/check-secrets.ts",
    "check:no-real-data": "tsx tools/check-no-real-data.ts",
    "check:copy": "tsx tools/copy-lint.ts",
    "check:size": "tsx tools/check-size.ts",
    "test": "vitest run --passWithNoTests",
    "test:golden": "vitest run tests/golden --passWithNoTests",
    "test:migrations": "vitest run tests/migrations --passWithNoTests",
    "test:crypto": "vitest run tests/crypto --passWithNoTests",
    "test:consent": "vitest run tests/consent --passWithNoTests",
    "test:sync": "vitest run tests/sync --passWithNoTests",
    "test:tz": "for tz in Pacific/Auckland America/New_York Europe/Berlin UTC America/Los_Angeles; do TZ=\"$tz\" vitest run --passWithNoTests || exit 1; done",
    "relay:test": "vitest run tests/relay --passWithNoTests",
    "backtest": "tsx tools/backtest/index.ts",
    "bench": "vitest bench --passWithNoTests tests/bench",
    "build": "tsx tools/build-precache.ts",
    "e2e": "npm run build && playwright test --pass-with-no-tests",
    "e2e:shots": "playwright test --pass-with-no-tests --grep @shots",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run check:deps && npm run check:secrets && npm run check:no-real-data && npm run check:copy && npm run test && npm run check:size"
  },
  "dependencies": {
    "@preact/signals": "2.11.3",
    "idb": "8.0.3",
    "jsqr": "1.4.0",
    "preact": "11.0.0",
    "qrcode-generator": "2.0.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "eslint": "10.11.0",
    "fast-check": "4.10.2",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "7.3.6",
    "vitest": "4.1.11",
    "wrangler": "4.147.0"
  }
}
